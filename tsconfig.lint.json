{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/**/*.ts",
    "tsconfig.lint.shims.d.ts",
    "vite.config.mts",
    "vitest.config.mts",
    "playwright.app.config.mts"
  ],
  "exclude": ["src/i18n/generated.ts", "node_modules", "dist", "src-tauri"]
}
