{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/core/**/*.ts", "src/main/**/*.ts", "tests/**/*.ts"],
  "exclude": ["tests/web"]
}
